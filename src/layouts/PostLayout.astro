---
import Navbar from '../components/ui/Navbar.astro';
import Footer from '../components/ui/Footer.astro';
import '../styles/global.css';
import '../components/narrative/styles.css'

import type { CollectionEntry } from 'astro:content';
import type { RelatedEntry } from '../lib/fns';
import { formatDate } from '../lib/fns';

type EssaysFrontmatter = CollectionEntry<'essays'>['data'];
type ProjectsFrontmatter = CollectionEntry<'projects'>['data'];

type PostFrontmatter = EssaysFrontmatter | ProjectsFrontmatter;

const { frontmatter, relatedEntries } = Astro.props as {
  frontmatter: PostFrontmatter;
  relatedEntries?: RelatedEntry[];
};
---


<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{frontmatter.title} | Mamihlapinatapai</title>
  </head>
  <body class="text-gray-900 antialiased min-h-screen selection:bg-yellow-200">
    <Navbar />
    
    <!-- The prose classes handle all the markdown typography automatically -->
    <main class="max-w-3xl mx-auto px-6 py-16 prose prose-lg prose-gray md:prose-xl">
      <!-- Article Header -->
      <header class="not-prose mb-12 py-12">
        <div class="flex items-center gap-3 text-sm text-gray-500 mb-4 font-mono">
          <span>{frontmatter.date.toISOString().split('T')[0]}</span>
          <span>—</span>
          <span class="uppercase tracking-widest text-blue-500">{frontmatter.title}</span>
        </div>
        <h1 class="text-4xl md:text-5xl xl:text-6xl font-mono tracking-tight text-gray-900 leading-tight">
          {frontmatter.title}
        </h1>
        <p class="text-xl text-gray-500 mt-4 italic">
          {frontmatter.description}
        </p>
      </header>

      <!-- The MDX content gets injected here -->
      <slot />

      <!-- Related Entries -->
      {
        relatedEntries && relatedEntries.length > 0 && (
          <section class="not-prose mt-16 pt-12 border-t border-surface">
            <h2 class="text-sm font-mono uppercase tracking-widest text-gray-800 mb-8">
              Continue Reading
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              {relatedEntries.map((entry) => (
                <a
                  href={`/${entry.collection}/${entry.id}`}
                  class="group block p-5 border border-gray-200 rounded-lg hover:border-blue-400 hover:shadow-sm transition-all"
                >
                  <div class="flex items-center gap-2 text-xs font-mono text-gray-500 mb-2">
                    <time datetime={entry.data.date.toISOString()}>
                      {formatDate(new Date(entry.data.date))}
                    </time>
                    {entry.data.topic && (
                      <>
                        <span>—</span>
                        <span class="uppercase tracking-widest text-blue-500">
                          {entry.data.topic}
                        </span>
                      </>
                    )}
                  </div>
                  <h3 class="text-lg font-mono font-semibold group-hover:text-blue-600 transition-colors">
                    {entry.data.title}
                  </h3>
                  {entry.data.description && (
                    <p class="text-sm text-gray-600 mt-1 leading-relaxed line-clamp-2">
                      {entry.data.description}
                    </p>
                  )}
                </a>
              ))}
            </div>
          </section>
        )
      }
    </main>

    <Footer />
  </body>
</html>